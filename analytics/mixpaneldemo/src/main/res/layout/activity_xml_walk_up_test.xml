<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Section: Basic Walk-Up -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Basic Walk-Up"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the text inside the button. $el_id should be 'add_to_cart_btn'."
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/walkup_basic_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="add_to_cart_btn"
            android:text="Add to Cart" />

        <!-- Section: Nested Clickables -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nested Clickables"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap 'Delete'. Walk-up stops at inner button ('delete_item'), not outer card ('product_card')."
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/walkup_outer_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="product_card"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/walkup_delete_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="delete_item"
                android:text="Delete"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Section: Clickable Container with Icon + Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clickable Container with Icon + Text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the icon or text. $el_id should be 'checkout_action'."
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/walkup_checkout_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="checkout_action"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_send" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Proceed to Checkout"
                android:textSize="16sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Section: No Clickable Ancestor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No Clickable Ancestor"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap below. No clickable ancestor exists. $el_id should be a hash fallback."
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/walkup_plain_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terms and Conditions apply."
            android:textSize="14sp"
            android:textColor="#888888"
            android:padding="8dp" />

        <!-- Section: Leaf Has Own Identity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leaf Has Own Identity"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the text. Even though it has its own contentDescription ('inner_label'), walk-up still activates and takes the clickable parent's identity. $el_id should be 'outer_container'."
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/walkup_outer_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="outer_button">

            <!-- Button in XML can't easily nest a TextView with its own contentDescription,
                 so we use a FrameLayout wrapper instead -->
        </Button>

        <!-- Alternative: FrameLayout as clickable with a labeled child -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="outer_container"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I have my own identity"
                android:contentDescription="inner_label" />
        </FrameLayout>

    </LinearLayout>
</ScrollView>
